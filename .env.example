# Copy to .env and fill in. .env is git-ignored; the token must never enter source control.
# Create a scoped API token: Atlassian account settings -> Security -> API tokens
# (recommended: select scopes, expiry <= 90 days for the pilot).

# Jira site hostname, e.g. "yourteam.atlassian.net" (no scheme, no trailing slash)
SCRUM_AGENT_JIRA_SITE=

# Account email that owns the API token
SCRUM_AGENT_JIRA_USER_EMAIL=

# The API token itself (scoped token recommended)
SCRUM_AGENT_JIRA_API_TOKEN=

# Auth mode:
#   basic_site     - Basic auth (email:token) against https://<site>          [classic tokens]
#   basic_central  - Basic auth against https://api.atlassian.com/ex/jira/<cloud_id>  [scoped tokens]
#   bearer_central - Bearer token against https://api.atlassian.com/ex/jira/<cloud_id>
# Scoped tokens must use the central endpoints; find your cloudId via the
# Configuration section in the README if a site-URL call returns 401/403.
SCRUM_AGENT_JIRA_AUTH_MODE=basic_central

# Required only for basic_central / bearer_central
SCRUM_AGENT_JIRA_CLOUD_ID=

# Week 1 probe targets
SCRUM_AGENT_JIRA_BOARD_ID=
SCRUM_AGENT_KNOWN_ISSUE_KEY=

# Pilot restriction: issue reads and searches are restricted to this project.
# Board metadata reads are restricted to SCRUM_AGENT_JIRA_BOARD_ID.
SCRUM_AGENT_JIRA_PROJECT_KEY=

# Reports render in this timezone (stored in UTC); pilot decision: Asia/Hong_Kong
SCRUM_AGENT_REPORT_TIMEZONE=Asia/Hong_Kong
